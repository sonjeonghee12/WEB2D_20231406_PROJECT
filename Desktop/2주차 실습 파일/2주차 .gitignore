# ============================================================
# Unity 6.x + 2D URP + WebGL 프로젝트용 .gitignore
# 사용법 : 프로젝트 루트 폴더에 복사 후 파일명을 .gitignore 로 변경
# ============================================================


# ============================================================
# Unity 자동 생성 폴더 (용량이 크고 로컬에서 자동 재생성됨)
# ============================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/


# ============================================================
# 빌드 출력물
# 앞에 / 를 붙이지 않아 하위 폴더의 빌드 결과도 함께 제외
# 예: Build, Builds, BuildWebGL, WebGL, WebGLBuild ...
# ============================================================
[Bb]uild/
[Bb]uilds/
[Bb]uild[Ww]eb*/
[Ww]eb[Gg][Ll]*/
*.wasm
*.unityweb
*.symbols.json
*.apk
*.aab
*.app
*.unitypackage


# ============================================================
# Unity 캐시 / 크래시 파일
# ============================================================
/[Cc]rash[Rr]eports/
/[Aa]ssets/[Aa]ssets[Ss]tore-5.x/
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*
sysinfo.txt
crashlytics-build.properties
*.pidb.meta
*.pdb.meta
*.mdb.meta


# ============================================================
# Visual Studio / VS Code 관련
# ============================================================
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db


# ============================================================
# JetBrains (Rider 등)
# ============================================================
.idea/
*.rider.user


# ============================================================
# OS 자동 생성 파일
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini


# ============================================================
# 대용량 원본 아트 파일 (선택)
# GitHub 파일 1개 제한 : 권장 50MB / 최대 100MB
# 원본 대신 PNG / OGG 로 내보내어 Assets 에 사용할 것
# 원본까지 관리하려면 아래 3줄을 주석 처리하고 Git LFS 사용
# ============================================================
*.psd
*.ai
*.wav
